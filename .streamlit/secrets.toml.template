# Streamlit Secrets Configuration Template
# Copy this file to .streamlit/secrets.toml and fill in your actual values
# SECURITY WARNING: Never commit .streamlit/secrets.toml to version control

# Google Drive Model Storage Configuration
# Replace with your actual Google Drive file ID
GOOGLE_DRIVE_MODEL_ID = "YOUR_GOOGLE_DRIVE_FILE_ID_HERE"

# Example:
# GOOGLE_DRIVE_MODEL_ID = "1ABC123DEF456GHI789JKL"

# SECURITY INSTRUCTIONS:
# 1. Upload your model file to Google Drive
# 2. Set sharing permissions to "Anyone with the link can view"
# 3. Get the shareable link
# 4. Extract the file ID from the link (the long alphanumeric string)
# 5. Replace YOUR_GOOGLE_DRIVE_FILE_ID_HERE with your actual file ID
# 6. Save this file as .streamlit/secrets.toml (remove .template extension)
# 7. NEVER commit the actual secrets.toml file to version control
# 8. For production deployment, set GOOGLE_DRIVE_MODEL_ID as environment variable
